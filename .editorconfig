# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Bedrock's own config files follow PSR-12.
[config/**.php]
indent_style = space

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[{composer.json,package.json,package-lock.json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
