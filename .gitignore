# Application: Composer-managed code is never committed.
web/app/plugins/*
!web/app/plugins/.gitkeep
web/app/mu-plugins/*/
!web/app/mu-plugins/northwind-core/
web/app/themes/*/
!web/app/themes/northwind/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# WordPress core (installed by Composer)
web/wp
web/.htaccess

# Logs
*.log

# Secrets and local environment
.env
.env.*
!.env.example
.ddev/.env
.ddev/.env.*
auth.json

# Composer
/vendor

# WP Engine build artifact
/build

# Node (accessibility tests)
node_modules
/tests/a11y/test-results
/tests/a11y/playwright-report

# WP-CLI
wp-cli.local.yml

# OS and editors
.DS_Store
.idea
.vscode
