{
  "name": "northwind/demo-site",
  "type": "project",
  "license": "MIT",
  "description": "Northwind Demo: a production-grade WordPress marketing site built on Roots Bedrock.",
  "keywords": [
    "bedrock", "wordpress", "composer", "acf", "block-theme", "wp-engine"
  ],
  "repositories": [
    {
      "name": "wpackagist",
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    },
    {
      "name": "acf-pro",
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "~7.1.5",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0",
    "wpackagist-plugin/redirection": "^5.0",
    "wpengine/advanced-custom-fields-pro": "^6.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Northwind\\Core\\": "web/app/mu-plugins/northwind-core/src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "build:wpengine": "bash scripts/build-wpengine.sh"
  },
  "scripts-descriptions": {
    "lint": "Check PHP against the WordPress Coding Standards.",
    "lint:fix": "Fix the coding standard violations that can be fixed automatically.",
    "build:wpengine": "Build the flattened wp-content artifact that is deployed to WP Engine."
  }
}
