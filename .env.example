# Copy to .env (ddev setup does this for you). Never commit .env.
#
# The defaults below match the DDEV project in .ddev/config.yaml.

DB_NAME='db'
DB_USER='db'
DB_PASSWORD='db'
DB_HOST='db'
# DB_PREFIX='wp_'

WP_ENV='development'
WP_HOME='https://northwind-demo.ddev.site'
WP_SITEURL="${WP_HOME}/wp"

# ACF Pro license key.
# Do NOT put the real key in this file. Export ACF_PRO_KEY in your shell (or
# add it to the gitignored .ddev/.env) before running ddev start. It is used
# for Composer authentication and, when present, to activate the plugin.
# ACF_PRO_KEY=''

# Generated by ddev setup. For other environments use https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
